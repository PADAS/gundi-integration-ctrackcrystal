		{
			"name": "Location_GetLocationsByIds",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var now = Date.now();\r",
							"var expires = pm.environment.get(\"x-tokentime\");\r",
							"var token = pm.environment.get(\"x-token\");\r",
							"var email = pm.environment.get(\"myemail\");\r",
							"var apiforauth = pm.environment.get(\"apiauth\");\r",
							"if (!apiforauth)\r",
							"     apiforauth = pm.environment.get(\"api\");\r",
							"if (email)\r",
							"{\r",
							"    var password = pm.environment.get(\"mypassword\");\r",
							"    console.log('expired yet?' + (expires < now ) + (typeof expires == 'undefined') + (typeof expires == null) + (token == null || (token == '')) );\r",
							"    if ((typeof expires == 'undefined') || (typeof expires == null) || (expires < now)) //|| (token == null || (token == '')) )\r",
							"    {\r",
							"        console.log('getting new token');\r",
							"        pm.sendRequest({\r",
							"            url: apiforauth+'/auth/api/Authentication/AuthenticateUser',\r",
							"            method: 'POST',\r",
							"            header: {\r",
							"                'content-type': 'application/json',\r",
							"            },\r",
							"            body: {\r",
							"                mode: 'raw',\r",
							"                raw: JSON.stringify({\"userName\":email,\"password\": password,\"applicationName\":\"Clarity Application\"})\r",
							"            }\r",
							"        }, function (err, res) {\r",
							"                var tokenret = res.json().JwtToken;\r",
							"                if (tokenret)\r",
							"                {\r",
							"                    pm.environment.set(\"x-token\", tokenret);\r",
							"                    pm.globals.set(\"x-tokenGlobal\", tokenret )\r",
							"                    var expires = now + 60000 * 5;//token should be fine for 5 mins\r",
							"                    pm.environment.set(\"x-tokentime\", expires);\r",
							"                    console.log(pm.environment.get(\"x-tokentime\"));\r",
							"                } else\r",
							"                {\r",
							"                    //2fa\r",
							"                    console.log(\"2fa\");\r",
							"                }\r",
							"        });\r",
							"    }\r",
							"}\r",
							"//pm.request.headers.add({key: 'x-token', value: '{{x-token}}' })"
						],
						"type": "text/javascript"
					}
				}
			],
			"protocolProfileBehavior": {
				"disableBodyPruning": true
			},
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Content-Type",
						"type": "text",
						"value": "application/json"
					},
					{
						"key": "Ocp-Apim-Subscription-Key",
						"value": "{{Ocp-Apim-Subscription-Key}}"
					},
					{
						"key": "x-token",
						"value": "{{x-token}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": ""
				},
				"url": {
					"raw": "{{api}}/api/Location/GetLocations",
					"host": [
						"{{api}}"
					],
					"path": [
						"api",
						"Location",
						"GetLocations"
					]
				},
				"description": "get all vehicles"
			},
			"response": []
