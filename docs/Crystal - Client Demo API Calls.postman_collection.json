	"item": [
		{
			"name": "Authenticate/Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"X-Token Setting\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.environment.unset(\"x-token\");\r",
							"    pm.environment.set(\"x-token\", jsonData.jwt);\r",
							"});\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"type": "text",
						"value": "application/json"
					},
					{
						"key": "Ocp-Apim-Subscription-Key",
						"value": "{{Ocp-Apim-Subscription-Key}}",
						"type": "default"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"username\": \"{{user}}\",\r\n  \"password\": \"{{password}}\"\r\n}"
				},
				"url": {
					"raw": "{{api}}/api/Authenticate/Login",
					"host": [
						"{{api}}"
					],
					"path": [
						"api",
						"Authenticate",
						"Login"
					]
				},
				"description": "get all vehicles"
			},
			"response": []
		},
